# ===================================================================
# CANDIDLY — VARIABLES D'ENVIRONNEMENT (.env.example)
# Master 2 MIAGE — Ingénierie des Processus Métiers (IPM)
# ===================================================================

# Informations générales de l'application
VITE_APP_TITLE="Candidly — Suivi de Candidatures et Carrière Professionnelle"
VITE_APP_PORT=3000

# Endpoint de l'API Backend Spring Boot (Optionnel pour l'intégration Full-Stack)
VITE_API_BASE_URL="http://localhost:8080/api"

# Clé Google Gemini utilisée uniquement par l'API serveur (ne pas préfixer par VITE_)

# Mode d'environnement (development / production)
VITE_APP_ENV="development"

GEMINI_API_KEY=
